# ──────────────────────────────────────────────────────────────────────────────
# CDN Network — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# APP_ENV: "production" enables startup validation of required credentials.
APP_ENV=development
APP_NAME=CDN Network
APP_HOST=0.0.0.0
APP_PORT=4500
API_PREFIX=/api/v1
LOG_LEVEL=debug              # debug | info | warn | error

# ── Authentication ────────────────────────────────────────────────────────────
# JWT_SECRET is read from config but not currently used for JWT issuance.
# Kept here for forward compatibility.
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# In development, falls back to http://localhost:5173,http://localhost:3000,http://localhost:4500.
# Required in production; warnings are emitted if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Trusted proxies ───────────────────────────────────────────────────────────
# Comma-separated CIDRs / IPs of upstream proxies allowed to set
# X-Forwarded-For and X-Forwarded-Host. Leave empty when running without
# a reverse proxy.
# Example: TRUSTED_PROXIES=172.20.0.0/16,10.0.0.1
TRUSTED_PROXIES=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cdn_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=cdn_network

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ── Local storage ─────────────────────────────────────────────────────────────
# Files are written to ./storage/ relative to the working directory.
# The storage directory is created automatically if it does not exist.
#
# STORAGE_SIGNING_SECRET: HMAC-SHA256 secret used to sign presigned GET/PUT URLs.
#   Generate with: openssl rand -hex 32
#   Required in production.
STORAGE_SIGNING_SECRET=REPLACE_WITH_STRONG_RANDOM_SIGNING_SECRET

# STORAGE_PUBLIC_BASE_URL: Base URL at which the storage HTTP handler is
#   publicly reachable. Used to build presigned URLs and public CDN links.
#   Example: https://cdn.example.com
#   Required in production.
STORAGE_PUBLIC_BASE_URL=http://localhost:4500

# ── Public URLs ───────────────────────────────────────────────────────────────
# BACKEND_URL is returned in health-check metadata.
BACKEND_URL=http://localhost:4500/api/v1

# PUBLIC_BASE_URL is used to build permanent CDN delivery URLs for public files:
#   <PUBLIC_BASE_URL>/cdn/<object-key>
PUBLIC_BASE_URL=http://localhost:4500

# ── CDN local-domain fallback ─────────────────────────────────────────────────
# When set, localhost / bare-IP delivery requests are routed as if they came
# from this hostname. Useful for local development smoke tests.
# Leave empty to disable.
CDN_LOCAL_DOMAIN=

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Config is loaded but SMTP sending is not yet wired in the application.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ──────────────────────────────────────────────────────────────
# CDN Network — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ──────────────────────────────────────────────────────────────

# Application
APP_ENV=development          # Set to "production" in prod
APP_NAME=CDN Network
APP_HOST=0.0.0.0
APP_PORT=4500
API_PREFIX=/api/v1
LOG_LEVEL=debug              # debug | info | warn | error

# JWT — REQUIRED. Generate with: openssl rand -hex 32
# Minimum 32 characters in production.
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# CORS — comma-separated list of allowed browser origins.
# Required in production; leave empty to disable cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cdn_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=cdn_network

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# MinIO / S3-compatible storage
# MINIO_ENDPOINT is host:port WITHOUT scheme (e.g. "localhost:9000").
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_ACCESS_KEY=           # Overrides MINIO_ROOT_USER when set
MINIO_SECRET_KEY=           # Overrides MINIO_ROOT_PASSWORD when set
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_REGION=               # Leave empty to let MinIO decide

# SMTP — required for email verification in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Backend public URL (used for health check response metadata)
BACKEND_URL=http://localhost:4500/api/v1
